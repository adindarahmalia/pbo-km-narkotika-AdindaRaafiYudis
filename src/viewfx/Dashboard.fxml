<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>


<?import javafx.scene.layout.VBox?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import com.sun.javafx.charts.Legend?>
<BorderPane xmlns="https://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllerfx.DashboardController">

    <top>
        <VBox spacing="5" alignment="CENTER"
              style="-fx-background-color:#1E3A8A; -fx-padding:18;">

            <children>
                <Label text="KNOWLEDGE MANAGEMENT SYSTEM"
                       style="-fx-text-fill:white; -fx-font-size:30; -fx-font-weight:bold;"/>
                <Label text="PUTUSAN PENGADILAN NARKOTIKA"
                       style="-fx-text-fill:white; -fx-font-size:30; -fx-font-weight:bold;"/>
            </children>
        </VBox>
    </top>


    <left>
        <VBox spacing="15"
              prefWidth="220"
              style="-fx-background-color:#263238; -fx-padding:20;">

            <children>
                <Button text="🏠 Dashboard"
                        prefWidth="180"
                        prefHeight="40"/>

                <Button text="📂 Repository"
                        prefWidth="180"
                        prefHeight="40"/>

                <Button text="➕ Tambah Putusan"
                        prefWidth="180"
                        prefHeight="40"/>

                <Button text="📊 Statistik"
                        prefWidth="180"
                        prefHeight="40"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button text="🚪 Keluar"
                        prefWidth="180"
                        prefHeight="40"/>
            </children>
        </VBox>
    </left>


    <center>

        <StackPane fx:id="contentPane">
        <VBox spacing="30"
              style="-fx-background-color:#ECEFF1; -fx-padding:35">

            <children>
                <Label text="Dashboard"
                       style="-fx-font-size:36; -fx-font-weight:bold"/>

                <HBox spacing="25">

                    <children>
                        <VBox prefWidth="250"
                              prefHeight="140"
                              alignment="CENTER"
                              spacing="10"
                              style="-fx-background-color:white; -fx-background-radius:15; -fx-border-radius:15; -fx-border-color:#DADADA;">

                            <children>

                                <Label text="TOTAL PUTUSAN"
                                       style="-fx-font-size:18; -fx-font-weight:bold; -fx-text-fill:#666666;"/>

                                <Label  fx:id="lblTotalPutusan"
                                        text="300"
                                       style="-fx-font-size:42; -fx-font-weight:bold; -fx-text-fill:#1E3A8A;"/>
                            </children>
                        </VBox>

                        <VBox prefWidth="250"
                              prefHeight="140"
                              alignment="CENTER"
                              spacing="10"
                              style="-fx-background-color:white; -fx-background-radius:15; -fx-border-radius:15; -fx-border-color:#DADADA;">

                                <children>
                                    <Label text="RATA-RATA VONIS"
                                           style="-fx-font-size:18; -fx-font-weight:bold; -fx-text-fill:#666666;"/>

                                    <Label  fx:id="lblRataVonis"
                                            text="38 Bulan"
                                           style="-fx-font-size:42; -fx-font-weight:bold; -fx-text-fill:#1E3A8A;"/>
                                </children>
                        </VBox>

                        <VBox prefWidth="250"
                              prefHeight="140"
                              alignment="CENTER"
                              spacing="10"
                              style="-fx-background-color:white; -fx-background-radius:15; -fx-border-radius:15; -fx-border-color:#DADADA;">

                                <children>
                                    <Label text="JENIS TERBANYAK"
                                           style="-fx-font-size:18; -fx-font-weight:bold; -fx-text-fill:#666666;"/>

                                    <Label  fx:id="lblJenisTerbanyak"
                                            text="Sabu-Sabu"
                                           style="-fx-font-size:42; -fx-font-weight:bold; -fx-text-fill:#1E3A8A;"/>
                                </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
        </StackPane>
    </center>
</BorderPane>